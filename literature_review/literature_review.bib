@article{https://doi.org/10.1155/2021/6245306,
author = {Kim, Ejin and Choi, Hyoung-Kee},
title = {Security Analysis and Bypass User Authentication Bound to Device of Windows Hello in the Wild},
journal = {Security and Communication Networks},
volume = {2021},
number = {1},
pages = {6245306},
doi = {https://doi.org/10.1155/2021/6245306},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1155/2021/6245306},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1155/2021/6245306},
abstract = {Windows Hello is a Fast IDentity Online- (FIDO-) based new login system for Windows 10, which provides a single sign-on (SSO) service to diverse online applications. Hardware protection is essential for Window Hello’s security. This paper aims to examine the security of Windows Hello on a device where hardware protection is unavailable. We present the first detailed analysis of Windows Hello’s security. The results show that, on a hardware-unsupported device, the authentication data for Windows Hello is not properly protected. We propose a migration attack to compromise Windows Hello’s security. In the proposed attack, an attacker extracts authentication data from a device to impersonate a victim in his or her Microsoft online account. We consider the possibility of such an attack to be serious and harmful to our society and demand immediate attention for remediation.},
year = {2021}
}

